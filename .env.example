# Node.js 24.x. Copy to .env if you need different settings.
PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/kidguard.sqlite
# Set NODE_ENV=production and APP_ORIGIN=https://your-domain for deployment.
# Set HOST=0.0.0.0 inside a container.
# Set TRUST_PROXY=1 ONLY behind one trusted reverse proxy.
# Mã này bảo vệ công cụ tạo mã giáo viên. Dùng chuỗi ngẫu nhiên dài và không đưa vào Git.
ADMIN_SETUP_SECRET=replace-with-a-long-random-secret
